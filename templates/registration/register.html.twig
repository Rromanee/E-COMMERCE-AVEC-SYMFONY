{% extends 'base.html.twig' %}

{% block title %}Inscription - Stubborn Shop{% endblock %}

{% block body %}

<div class="form-container">

    <div class="form-card">

        <div class="form-card-body">

            <h2 class="form-title"> S’inscrire </h2>

            <hr class="separator">

            {{ form_start(registrationForm) }}

                <div class="mb-3">
                    {{ form_label(registrationForm.name, "Nom d’utilisateur") }}

                    {{ form_widget(registrationForm.name, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': 'Entrez votre nom'
                        }
                    }) }}
                </div>

                <div class="mb-3">
                    {{ form_label(registrationForm.email, "Adresse email") }}

                    {{ form_widget(registrationForm.email, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': 'Entrez votre email'
                        }
                    }) }}
                </div>

                <div class="mb-4">
                    {{ form_label(registrationForm.delivery_address, "Adresse de livraison") }}

                    {{ form_widget(registrationForm.delivery_address, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': 'Entrez votre adresse'
                        }
                    }) }}
                </div>

                <div class="mb-3">
                    {{ form_label(registrationForm.plainPassword.first, "Mot de passe") }}

                    {{ form_widget(registrationForm.plainPassword.first, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': 'Mot de passe'
                        }
                    }) }}
                </div>

                <div class="mb-4">
                    {{ form_label(registrationForm.plainPassword.second, "Confirmer le mot de passe") }}

                    {{ form_widget(registrationForm.plainPassword.second, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': 'Confirmez le mot de passe'
                        }
                    }) }}
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary mb-3">
                        Créer un compte
                    </button>
                </div>

            {{ form_end(registrationForm) }}

            <hr class="separator">

            <p class="text-center mb-3">
                Déjà inscrit ?
            </p>

            <div class="text-center">
                <a href="{{ path('app_login') }}"
                   class="btn btn-primary mb-3">
                    Se connecter
                </a>
            </div>

        </div>

    </div>

</div>

{% endblock %}