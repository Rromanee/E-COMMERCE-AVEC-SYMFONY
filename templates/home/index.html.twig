{% extends 'base.html.twig' %}

{% block title %}Accueil - Stubborn Shop{% endblock %}

{% block body %}
    <div class="row mb-5">
        {% if products|length == 0 %}
            <div class="col-12 text-center">
                <p class="lead">Aucun produit mis en avant pour le moment.</p>
            </div>
        {% else %}
            {% for product in products %}
                <div class="col-md-4 mb-4">
                    <div class="product-card">
                        <img src="{{ asset('images/products/' ~ product.image) }}" class="product-image" alt="{{ product.name }}">
                        
                        <div class="product-info">
                            <div class="product-details">
                                <h5 class="product-name">{{ product.name }}</h5>
                                <p class="product-price">{{ product.price }} €</p>
                            </div>
                            
                            {% if app.user %}
                                <a href="{{ path('app_product_detail', {'id': product.id}) }}" class="btn-action">Voir</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
{% endblock %}