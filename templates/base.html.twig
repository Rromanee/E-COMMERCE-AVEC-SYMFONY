<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Stubborn Shop{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="{{ asset('css/style.css') }}" rel="stylesheet">
    <link rel="icon" href="{{ asset('images/logo.png') }}"></head>
<body>

    <header class="header-container">
        <div class="brand-section">
            <div class="brand-box">
                <div class="brand-name">Stubborn</div>
            </div>
            <div class="brand-slogan">"Don't compromise on your look"</div>
        </div>

        <nav class="nav-menu">
            <ul>
                <li>
                    <a href="{{ path('app_home') }}" class="{% if app.request.attributes.get('_route') == 'app_home' %}active{% endif %}">
                        Accueil
                    </a>
                </li>
                
                {% if app.user %}
                    <!-- Menu CONNECTÉ -->
                    <li>
                        <a href="{{ path('app_products') }}" class="{% if app.request.attributes.get('_route') == 'app_products' %}active{% endif %}">
                            Boutique
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_cart') }}" class="{% if app.request.attributes.get('_route') == 'app_cart' %}active{% endif %}">
                            Panier
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_logout') }}">Se déconnecter</a>
                    </li>
                {% else %}
                    <!-- Menu NON CONNECTÉ -->
                    <li>
                        <a href="{{ path('app_register') }}" class="{% if app.request.attributes.get('_route') == 'app_register' %}active{% endif %}">
                            S'inscrire
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_login') }}" class="{% if app.request.attributes.get('_route') == 'app_login' %}active{% endif %}">
                            Se connecter
                        </a>
                    </li>
                {% endif %}
            </ul>
        </nav>
    </header>

    <main class="container">
        {% block body %}{% endblock %}
    </main>

    <footer class="container">
        <div class="company-info-box">
            <h3>Informations de la société</h3>
            <table class="info-table">
                <tbody>
                    <tr>
                        <td class="info-label"><strong>Nom de la société :</strong></td>
                        <td>Stubborn</td>
                    </tr>
                    <tr>
                        <td class="info-label"><strong>Adresse :</strong></td>
                        <td>Piccadilly Circus, London W1J 0DA, Royaume-Uni</td>
                    </tr>
                    <tr>
                        <td class="info-label"><strong>Adresse de contact :</strong></td>
                        <td>stubborn@blabla.com</td>
                    </tr>
                </tbody>
            </table>
            <hr>
            <p><strong>À propos de Stubborn :</strong></p>
            <p>Stubborn est une marque londonienne née à Piccadilly Circus. Nous proposons des vêtements de qualité qui ne font aucun compromis sur le style. Notre mission est de vous offrir des pièces uniques qui reflètent votre personnalité sans concession.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>